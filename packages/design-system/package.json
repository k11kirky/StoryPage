{
  "name": "@storypage/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./registry.json": "./src/generated/registry.json",
    "./tokens.css": "./src/generated/tokens.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "tsx scripts/generate.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build-storybook --quiet"
  },
  "dependencies": {
    "@storypage/schema": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "^7.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "storybook": "^10.6.4",
    "vite": "^7.1.0",
    "@types/semver": "^7.7.0"
  }
}
