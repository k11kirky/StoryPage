# Shared secret the Figma plugin sends as "Authorization: Bearer <token>".
GATEWAY_PUBLISH_TOKEN=
# Repository the design system lives in, and a token that can push branches and send repository_dispatch.
GITHUB_REPOSITORY=acme/storypage
GITHUB_TOKEN=
GITHUB_BASE_BRANCH=main
PORT=8787

# Draft previews for Storybook (optional). PREVIEW_SIGNING_SECRET must match the Slack bot's.
PREVIEW_SIGNING_SECRET=
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_LOCALE=en-US
