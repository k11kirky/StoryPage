# Shared secret the Figma plugin sends as "Authorization: Bearer <token>".
GATEWAY_PUBLISH_TOKEN=
# Repository the design system lives in, and a token that can push branches and send repository_dispatch.
GITHUB_REPOSITORY=acme/storypage
GITHUB_TOKEN=
GITHUB_BASE_BRANCH=main
PORT=8787

# Draft previews for Storybook (optional). PREVIEW_SIGNING_SECRET must match the Slack bot's.
PREVIEW_SIGNING_SECRET=
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_LOCALE=en-US

# Where the agents run: github (Actions in your repo, default) or local (this process, e.g. the Dockerfile).
STORYPAGE_RUNNER=github
# local runner only:
STORYPAGE_PUBLIC_URL=https://storypage.example.com
STORYPAGE_WORKDIR=/data
GITHUB_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
FIGMA_MCP=

# Figma's "Publish library" starts releases. Register with `pnpm --filter @storypage/gateway figma:webhook`.
FIGMA_API_KEY=
FIGMA_FILE_KEYS=
FIGMA_WEBHOOK_PASSCODE=
# Slack incoming webhook where designers hear what happened after publishing.
SLACK_NOTIFY_WEBHOOK_URL=
